# Postgres connection (production only — leave unset locally to use PGlite at ./dev-db)
DATABASE_URL=
# Base URL of the app (used to build the Twitch OAuth redirect URI)
APP_URL=http://localhost:3000
# Twitch developer app credentials (used for both IGDB and Twitch OAuth sign-in)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Dev only (ignored unless NODE_ENV !== production): set to "true" to skip
# Twitch auth entirely and act as a fixed synthetic dev user.
DISABLE_AUTH=
